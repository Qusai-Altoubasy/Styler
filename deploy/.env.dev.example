# Copy to deploy/.env.dev and fill in the values:
#   cp deploy/.env.dev.example deploy/.env.dev
# Used by deploy/compose.dev.yaml (passed with --env-file) for both the db and api containers.

# PostgreSQL container (applied on the first start of an empty styler-db-data volume)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Locale provider for the new database: PostgreSQL's own, independent of the OS (glibc
# or musl), so sorting and indexes never change with the base image. Keep this value.
POSTGRES_INITDB_ARGS=--locale-provider=builtin --builtin-locale=C.UTF-8

# API
# development | production
ENVIRONMENT=development
# postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
DATABASE_URL=

# The request header that carries the customer's real IP, filled by the CDN.
# Production: CloudFront-Viewer-Address. Local development (no CDN): leave empty,
# and the address of the connection itself is used.
CLIENT_IP_HEADER=

# Tests only: a separate database on the same server, dropped and rebuilt with
# `alembic upgrade head` on every test run. Never point it at real data.
# postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>_test
TEST_DATABASE_URL=

# Images storage (S3; MinIO locally)
# The images bucket. Locally: any name, created by the storage-init service.
S3_BUCKET=
# Production: eu-west-1. Locally: the same, MinIO accepts it (MINIO_SITE_REGION below).
S3_REGION=
# Where the API reaches the storage. Production: empty (real S3).
# Locally: http://minio:9000 (the service name on styler-net).
S3_ENDPOINT_URL=
# Where the manager's browser uploads to (the presigned POST link). Production: empty
# (real S3). Locally: http://127.0.0.1:9000, MinIO as seen from your machine.
S3_PUBLIC_ENDPOINT_URL=
# Production: the server's IAM key, limited to the images and backups buckets.
# Locally: MINIO_ROOT_USER and MINIO_ROOT_PASSWORD below.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Tests only: a separate bucket in MinIO, created and emptied by the media tests.
# Its name must end in -test. Never point it at real images.
TEST_S3_BUCKET=

# MinIO container (local development only; production uses S3)
MINIO_ROOT_USER=
# At least 8 characters.
MINIO_ROOT_PASSWORD=
# The region MinIO answers as; keep it equal to S3_REGION.
MINIO_SITE_REGION=
# Origins allowed to upload from the browser (the dashboard's dev server), comma separated.
# e.g. http://localhost:5173
MINIO_API_CORS_ALLOW_ORIGIN=

# Your user and group ids on this machine (`id -u` and `id -g`). The api container
# runs as this user so files it writes into backend/ stay yours.
HOST_UID=
HOST_GID=

# Dev tooling inside the api container
PYTHONDONTWRITEBYTECODE=1
RUFF_CACHE_DIR=/tmp/ruff-cache
