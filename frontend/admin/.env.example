# Copy to admin/.env and fill in the values (dev server only; never committed).
#   cp .env.example .env

# Where the dev server proxies /api/*: the api container from deploy/compose.dev.yaml.
# e.g. http://127.0.0.1:8000
API_PROXY_TARGET=
# Where the dev server proxies /media/*: MinIO plus the images bucket (S3_BUCKET in
# deploy/.env.dev). e.g. http://127.0.0.1:9000/<S3_BUCKET>
MEDIA_PROXY_TARGET=
